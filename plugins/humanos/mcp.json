{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "humanos": {
      "type": "streamable-http",
      "url": "https://gateway.standardcybernetics.com/api/tracker-agents/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": {
              "mode": "dcr"
            },
            "baseScopes": [
              "tracker:submit",
              "offline_access"
            ]
          }
        }
      }
    }
  }
}
